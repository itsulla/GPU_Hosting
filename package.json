{
  "name": "gpuhosting-guide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.source.css -o tailwind.generated.css --minify",
